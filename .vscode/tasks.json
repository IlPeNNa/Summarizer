      "label": "Start NLP Service",
      "type": "shell",
      "command": "cd nlp-service; if (Test-Path '.venv\\Scripts\\Activate.ps1') { .venv\\Scripts\\Activate.ps1 }; python app/main.py",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
